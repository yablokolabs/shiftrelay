{
  "name": "shiftrelay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ShiftRelay: carry technician-approved fixes across support shifts with Meko.",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "smoke": "tsx scripts/meko-smoke.ts",
    "seed": "tsx scripts/seed.ts",
    "eval": "tsx scripts/evaluate.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "checkpoints": "tsx scripts/checkpoint.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
