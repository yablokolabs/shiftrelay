# Server-side only. Never expose these values to the browser or commit them.
MEKO_API_KEY=mko_tkn_replace_me
MEKO_MCP_URL=https://mcp.mekodata.ai/mcp
MEKO_API_BASE=https://api.mekodata.ai/api/v1

# Filled by `npm run seed` (or paste existing IDs).
MEKO_DATAPACK_ID=
MEKO_EVAL_BASELINE_DATAPACK_ID=
MEKO_EVAL_TREATMENT_DATAPACK_ID=

# Optional model. Without a key the server uses the deterministic responder and
# labels it in the UI and evaluation evidence.
MODEL_PROVIDER=deterministic
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

PORT=8787
